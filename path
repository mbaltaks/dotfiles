# Default PATH for Mac OS X 10.7
# /usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/usr/X11/bin
# Default PATH for some older Mac OS X version
#PATH="${PATH}:/bin:/sbin:/usr/bin:/usr/sbin:/usr/X11R6/bin"

# Prepend new folder to variable (if it exists)
path_prepend()
{
    [ -d "$1" ] && NEWPATH="${NEWPATH}:$1"
}

# User specific folders
path_prepend "$HOME/bin"
path_prepend "$HOME/.dotfiles/bin"

# Python / Haskell stack
#path_prepend "$(pyenv root)/shims"
path_prepend "${HOME}/.local/bin"

# Machine local folders, including Homebrew
path_prepend "/usr/local/bin"
path_prepend "/usr/local/sbin"

# MacPorts
path_prepend "/opt/local/bin"
path_prepend "/opt/local/sbin"
path_prepend "/opt/local/Library/Frameworks/Python.framework/Versions/2.7/bin"
path_prepend "/opt/local/Library/Frameworks/Python.framework/Versions/3.6/bin"

# Homebrew
path_prepend "/opt/homebrew/bin"
path_prepend "/opt/homebrew/sbin"

# Xcode tools
path_prepend "/Applications/Xcode.app/Contents/Developer/Tools"

# Kotlin
path_prepend "${HOME}/Applications/Android Studio.app/Contents/plugins/Kotlin/kotlinc/bin"

# Heroku
path_prepend "/usr/local/heroku/bin"

# Git
path_prepend "/opt/local/share/git/contrib/diff-highlight"
path_prepend "/opt/homebrew/share/git-core/contrib/diff-highlight"

# Android development
path_prepend "/Users/Data/Android-SDKs/sdk/tools"
path_prepend "/Users/Data/Android-SDKs/sdk/platform-tools"
path_prepend "/Users/Data/Android-SDKs/sdk/tools/bin"
path_prepend "/Users/Data/Android-SDKs/sdk/emulator"
path_prepend "$HOME/Applications/Android Studio.app/sdk/tools"
path_prepend "$HOME/Applications/Android Studio.app/sdk/platform-tools"

# WebKit JavaScript interpreter
path_prepend "/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Resources"
#path_prepend "/Developer/Platforms/iPhoneOS.platform/Developer/usr/bin"

# Fink
#PATH="${PATH}:/sw/bin:/sw/sbin"
#PATH=${PATH}:/usr/local/*/bin

# Postgres.app
path_prepend "/Applications/Postgres.app/Contents/Versions/latest/bin"

# Visual Studio Code
path_prepend "$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# Perforce
path_prepend "$HOME/Applications/p4merge.app/Contents/MacOS"

PATH="${NEWPATH}:${PATH}"
export PATH

# NEW_C_INCLUDE_PATH=${C_INCLUDE_PATH}:/opt/local/include
# C_INCLUDE_PATH=${NEW_C_INCLUDE_PATH}
# export C_INCLUDE_PATH

# Add a few extra places to the man path
# Also add them to /usr/share/misc/man.conf
NEWMANPATH="/usr/local/man:/usr/local/share/man"
NEWMANPATH="${NEWMANPATH}:/opt/local/man:/opt/local/share/man"
MANPATH="${NEWMANPATH}:${MANPATH}"
export MANPATH

# clean up
unset path_prepend

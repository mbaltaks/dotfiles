{
    "editor.fontFamily": "Hasklig, Source Code Pro, Monoid, Fira Code, Menlo, Monaco, 'Courier New', monospace",
    "editor.scrollBeyondLastLine": false,
    "editor.scrollBeyondLastColumn": 3,
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.formatOnSave": true,
    "editor.renderControlCharacters": true,
    "editor.renderWhitespace": "all",
    "workbench.statusBar.feedback.visible": false,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "explorer.confirmDelete": false,
    "search.useIgnoreFiles": true,
    "debug.node.autoAttach": "off",
    "vim.neovimPath": "/usr/local/bin/nvim",
    "vim.enableNeovim": false,
    "vim.whichwrap": "[,]",
    "python.venvPath": "/Users/mick/.local/share/virtualenvs",
    "breadcrumbs.enabled": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "extensions.autoUpdate": "on",
    "editor.detectIndentation": false,
    "files.associations": {
        "*.h": "objective-cpp"
    },
    "editor.fontLigatures": true,
    "vscode-neovim.neovimExecutablePaths.darwin": "/usr/local/bin/nvim",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter.notebook.ipynb"
    },
    "mssql.connections": [],
    "editor.guides.indentation": false,
    "editor.fontSize": 13,
    "sourcekit-lsp.serverPath": "/usr/bin/xcrun sourcekit-lsp",
    "telemetry.enableCrashReporter": false,
    "telemetry.enableTelemetry": false,
    "redhat.telemetry.enabled": false,
    "telemetry.telemetryLevel": "off",
    "workbench.colorTheme": "Solarized Light",
    "[objective-cpp]": {
        "editor.colorDecorators": true
    },
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "lldb.launch.expressions": "native",
    "makefile.configureOnOpen": true
}
